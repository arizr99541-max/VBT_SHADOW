    local function createBillboard(char)
        if not char then return end
        local hrp = char:WaitForChild("HumanoidRootPart", 3)
        if not hrp then return end
        
        local oldBB = wpFolder:FindFirstChild(player.Name .. "_WP")
        if oldBB then oldBB:Destroy() end
        
        if UTILS_CONFIG.WaypointESPEnabled then
            local bb = Instance.new("BillboardGui")
            bb.Name = player.Name .. "_WP"
            bb.Adornee = hrp
            bb.Size = UDim2.new(0, 150, 0, 35)
            bb.AlwaysOnTop = true
            bb.Parent = wpFolder
            
            local label = Instance.new("TextLabel")
            label.Size = UDim2.new(1, 0, 1, 0)
            label.BackgroundTransparency = 1
            label.TextColor3 = Color3.fromRGB(180, 100, 255)
            label.TextStrokeTransparency = 0
            label.Font = Enum.Font.GothamBold
            label.TextSize = 12
            label.Parent = bb
            
            task.spawn(function()
                while UTILS_CONFIG.WaypointESPEnabled and char and char.Parent and hrp and hrp.Parent do
                    local myHRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                    if myHRP then
                        local dist = math.floor((hrp.Position - myHRP.Position).Magnitude)
                        label.Text = string.format("🌑 [Shadow] %s\n[%d Studs]", player.DisplayName, dist)
                    end
                    task.wait(0.2)
                end
                bb:Destroy()
            end)
        end
    end
    
    if player.Character then
        createBillboard(player.Character)
    end
    player.CharacterAdded:Connect(function(char)
        task.wait(0.5)
        createBillboard(char)
    end)
end

